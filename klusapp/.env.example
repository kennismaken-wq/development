# Kopieer naar .env en vul in. Lokaal is alleen DJANGO_DEBUG nodig.
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=          # verplicht zodra DEBUG uit staat
# DJANGO_ALLOWED_HOSTS=klusapp.degroenem.nl
# DJANGO_CSRF_TRUSTED_ORIGINS=https://klusapp.degroenem.nl
# DATABASE_URL=postgres://klusapp:wachtwoord@localhost:5432/klusapp
# MEDIA_ROOT=/var/klusapp/media
# Wekelijkse urenback-up per mail — zie docs/DEPLOY.md, "Back-ups".
# EMAIL_HOST=smtp.voorbeeld.nl
# EMAIL_PORT=587              # 465 schakelt vanzelf over op SSL
# EMAIL_HOST_USER=maarten@voorbeeld.nl
# EMAIL_HOST_PASSWORD=        # app-wachtwoord, niet het gewone wachtwoord
# URENBACKUP_ADRES=           # standaard hetzelfde als EMAIL_HOST_USER
